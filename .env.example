# Environment Configuration Example
# Copy this file to .env and modify as needed for your environment

# FastAPI Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_RELOAD=false
BACKEND_WORKERS=4

# Frontend
FRONTEND_PORT=8080
FRONTEND_API_URL=http://localhost:8000

# Model Server
MODEL_PORT=8001
MODEL_HOST=0.0.0.0

# ML Model Configuration
MODEL_PATH=/app/models/logreg_C0.0001_feat250_aug5.joblib
VECTORIZER_PATH=/app/models/logreg_C0.0001_feat250_aug5_vectorizer.joblib

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# CORS
CORS_ORIGINS=["http://localhost:8080", "http://localhost:3000"]
CORS_CREDENTIALS=true
CORS_METHODS=["GET", "POST", "OPTIONS"]
CORS_HEADERS=["Content-Type"]

# Database (future)
# DATABASE_URL=sqlite:///./projectx.db

# Security (future)
# SECRET_KEY=your-secret-key-here
# ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=30

# Monitoring (future)
# SENTRY_DSN=your-sentry-dsn
# PROMETHEUS_ENABLED=true

# Environment
ENVIRONMENT=development
# ENVIRONMENT=production

# Debug
DEBUG=false

# Python
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1
