# Sistema / VCS / CI
.git
.gitignore
.github
.gitattributes
docker-compose.override.yml

# Entornos virtuales / caches / bytecode (ya tenías muchos de estos)
.venv
env/
venv/
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# Notebooks / datos / salidas / modelos locales (no incluir pesos ni datos)
notebooks/
.ipynb_checkpoints
data/
data/*
!data/.gitkeep
outputs*/
!outputs/.gitkeep

# Dependencias de frontend / build artifacts
node_modules/
dist/
build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Archivos de logs / DB locales
*.log
logs/
*.sqlite
*.db
db.sqlite3

# Entornos y configuración local / secretos
.env
.env.*
.envrc
.env.local
*.pem
*.key
*.crt
credentials
.aws/
.azure/
.gcloud/

# Editor / IDE
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Herramientas / caches / testing
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
.coverage
coverage.xml
htmlcov/

# Archivos y directorios temporales
tmp/
temp/
*.tmp
*.swp
*~

# OS
.DS_Store
Thumbs.db

# Evitar incluir Docker artifacts (no ignorar Dockerfile)
.dockerignore

# Si tienes scripts de CI locales o archivos de configuración personal:
local_configs/
*.local

# Nota: si el frontend está en ./frontend y se hace 'COPY . .' en su Dockerfile,
# el frontend/Dockerfile debe basarse en copiar solo lo necesario (ej. COPY ./frontend/build /usr/share/nginx/html)
